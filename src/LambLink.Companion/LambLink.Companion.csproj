<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.43</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE_DISTRIBUTION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableReleaseTestTools)' == 'true'">
    <DefineConstants>$(DefineConstants);RELEASE_TEST_TOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>LambLink.DonationTests</_Parameter1>
    </AssemblyAttribute>
    <EmbeddedResource Include="Overlay\OverlayBootstrap.html" LogicalName="LambLink.OverlayBootstrap.html" />
    <ProjectReference Include="..\LambLink.Protocol\LambLink.Protocol.csproj" />
  </ItemGroup>
</Project>
